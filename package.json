{
  "name": "@rangerwild/mcp-server",
  "version": "0.2.0",
  "description": "Model Context Protocol server for Ranger Wild — AI-native zoo + wildlife centre management. Install in Claude Desktop, ChatGPT, Cursor, or any MCP client to drive your centre from the chat window.",
  "bin": {
    "ranger-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-mcp.mjs",
    "preflight": "npm run build",
    "prepublishOnly": "npm run build && echo 'skipping live smoke — run manually with RANGER_API_KEY set'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.18.0"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "ranger-wild",
    "zoo",
    "wildlife",
    "ai-native"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philgillett-git/ranger-mcp.git"
  },
  "license": "MIT",
  "homepage": "https://developers.rangerwild.com",
  "bugs": {
    "url": "https://github.com/philgillett-git/ranger-mcp/issues"
  }
}
